[Desktop Entry]
Type=Application
Version=1.0
Name=Music Player
Name[zh_CN]=音乐播放器
Comment=Play local music and display synchronized lyrics
Comment[zh_CN]=播放本地音乐并显示同步歌词
Exec=music-linux
Icon=music-linux-player
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=Music;Audio;Player;Lyrics;
Keywords[zh_CN]=音乐;音频;播放器;歌词;
StartupNotify=true
StartupWMClass=music-linux
